  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"You are a young girl, born in a quiet town of the 19th century\u2026\nBut
    you are no ordinary child.\nYou are the vessel \u2014 the last barrier between
    this world and the endless tide of monsters beyond.\n\nAt the heart of your town
    lies the Sun Temple\u2026 once radiant, now crumbling. Its power wanes, its light
    fading. And with it, the seal that keeps the horrors away begins to break.\n\nTo
    save your people, you must journey across dimensions\u2026 slipping between worlds,
    facing the unkillable shadows that hunt you relentlessly.\n\nBut beware\u2026
    should you fall\u2026 the gateway opens.\nAnd your world will be consumed.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 207065e95744347e29d68ee439d89170, type: 2}
  m_sharedMaterial: {fileID: 9025461450022648644, guid: 207065e95744347e29d68ee439d89170, type: 2}
